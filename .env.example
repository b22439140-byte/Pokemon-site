# Admin login password (default without this: pokevault)
ADMIN_PASSWORD=pokevault

# OpenRouter — required for admin "AI invullen" card scan
# Get a key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-...

# Optional vision model (default: google/gemini-2.5-flash)
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_MODEL=openai/gpt-4o-mini
