# Admin login password (default without this: pokevault)
ADMIN_PASSWORD=pokevault

# OpenRouter — required for admin "AI invullen" card scan
# Get a key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-...

# Optional vision model (default: google/gemini-2.5-flash)
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_MODEL=openai/gpt-4o-mini

# bunq checkout (bunq.me tabs) — keep the API key server-side only
# Generate in the bunq app: Profile → Security & settings → Developers → API keys
#
# REQUIRED for Render/cloud hosts:
# In the bunq app, open that API key and enable "Allow All IP Addresses".
# Without that you get: "Incorrect API key or IP address".
BUNQ_API_KEY=

# Use sandbox API (true/false). Default: production
# Real key from the bunq app  => BUNQ_SANDBOX=false (or leave unset)
# Sandbox/test key            => BUNQ_SANDBOX=true
# BUNQ_SANDBOX=false

# Optional fallback public URL (no trailing slash). Checkout prefers the
# request host automatically so customers stay on the same domain.
# Set this to your canonical live URL if you use a custom domain, e.g.:
# PUBLIC_BASE_URL=https://pokemon-site-jtzz.onrender.com
PUBLIC_BASE_URL=

# Optional: force a specific monetary account id (otherwise first ACTIVE account)
# BUNQ_MONETARY_ACCOUNT_ID=

# Optional crypto checkout — shown on the order page after "Crypto" is chosen
# CRYPTO_WALLET_ADDRESS=bc1q...
# CRYPTO_WALLET_NETWORK=BTC / ETH / USDT

# Shipping defaults (optional). Prefer changing these in Admin → Verzending.
# Env values only apply until shipping is saved once in admin.
# SHIPPING_FEE_DOMESTIC=6.95
# SHIPPING_FEE_INTERNATIONAL=14.95
# FREE_SHIPPING_FROM_DOMESTIC=100
# FREE_SHIPPING_FROM_INTERNATIONAL=150

# Order confirmation emails — contact form stays in Admin (no outbound mail needed).
#
# RECOMMENDED: Resend (free, easy) — https://resend.com
# 1) Create API key
# 2) For testing: MAIL_FROM can stay onboarding@resend.dev (only to your Resend signup email)
# 3) For real customers: Domains → add pokëvault.com → DNS records → then:
#    MAIL_FROM=PokeVault <Info@pokëvault.com>
RESEND_API_KEY=
MAIL_FROM=PokeVault <onboarding@resend.dev>
MAIL_NOTIFY_TO=Info@pokëvault.com
#
# Optional fallback: Strato SMTP (only if Resend is not set)
# SMTP_HOST=smtp.strato.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=Info@pokëvault.com
# SMTP_PASS=
# Test: Admin → Verzending → Stuur testmail
